# ==============================================================================
# EventCheck - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholders with your private local values.
# NEVER commit .env to version control.
# ==============================================================================

# Database Connection (Dedicated PostgreSQL Cluster on Port 5433)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://eventcheck_app:YOUR_SECURE_PASSWORD@127.0.0.1:5433/eventcheck_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://eventcheck_app:YOUR_SECURE_PASSWORD@127.0.0.1:5433/eventcheck_shadow?schema=public"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Session Security (Minimum 32 random characters in production)
SESSION_SECRET="change-this-to-a-secure-random-secret-for-session-signing"

# Rate Limiting & Abuse Prevention
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE="60"

# Notification Provider Stubs (Disabled by default)
ENABLE_NOTIFICATIONS="false"
WHATSAPP_PROVIDER_ENABLED="false"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
