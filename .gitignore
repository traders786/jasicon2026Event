# env files (secrets protection)
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local dedicated PostgreSQL cluster & data
.pgdata/
/.pgdata/
*.log
